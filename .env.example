# Local development values only. Copy this file to .env before running the API
# or the web shell on the host. Do not put production secrets here.
#
# Docker Compose reads this file for variable substitution and overrides
# DATABASE_URL, REDIS_URL, and API_INTERNAL_URL inside the containers.

NODE_ENV=development
API_PORT=4000
LOG_LEVEL=info

# Host-side API. Compose replaces the hostnames with postgres and redis.
DATABASE_URL=postgresql://culturespace:culturespace@127.0.0.1:5432/culturespace
REDIS_URL=redis://127.0.0.1:6379

# At least 32 characters. Production startup rejects this development value.
SESSION_SECRET=dev-only-session-secret-change-me!!

# Browser origin of the web shell. Production must use https.
APP_ORIGIN=http://localhost:3000

# Server-side GraphQL proxy target used by Next.js. Not a public URL.
# Use http://127.0.0.1:4000 for host development.
# Compose sets http://api:4000 for the web container.
API_INTERNAL_URL=http://127.0.0.1:4000

# Published only on 127.0.0.1 by the development Compose file.
POSTGRES_USER=culturespace
POSTGRES_PASSWORD=culturespace
POSTGRES_DB=culturespace
POSTGRES_PORT=5432
REDIS_PORT=6379
WEB_PORT=3000

# MinIO and Mailpit. Host development uses these defaults when the variables
# are omitted. Compose points the API at the mailpit service and at
# host.docker.internal:9000 so a presigned avatar URL is reachable from the
# browser. Production rejects the sample MinIO secret and requires https for
# MINIO_PUBLIC_BASE_URL.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=noreply@culturespace.local
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=culturespace
MINIO_SECRET_KEY=culturespace-dev-only
MINIO_BUCKET=avatars
MINIO_PUBLIC_BASE_URL=http://127.0.0.1:9000
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BACKOFF_MS=1000
OUTBOX_QUEUE_NAME=cs-outbox

MINIO_ROOT_USER=culturespace
MINIO_ROOT_PASSWORD=culturespace-dev-only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Used only by `pnpm --filter @culture-space/api bootstrap:admin`.
# Do not commit a real administrator password.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_FULL_NAME=
# BOOTSTRAP_ADMIN_LANGUAGE=en
