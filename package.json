{
  "name": "culture-space",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:api": "pnpm --filter @culture-space/api dev",
    "dev:web": "pnpm --filter @culture-space/web dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:integration": "pnpm --filter @culture-space/api test:integration",
    "test:e2e": "pnpm --filter @culture-space/api test:e2e",
    "migration:prepare": "pnpm --filter @culture-space/api migration:prepare",
    "migration:run": "pnpm --filter @culture-space/api migration:run",
    "migration:verify": "pnpm --filter @culture-space/api migration:verify",
    "migration:show": "pnpm --filter @culture-space/api migration:show",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
